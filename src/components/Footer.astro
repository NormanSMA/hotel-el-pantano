---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

import Icon from "./ui/Icon.astro";
import { site, contact, hours, whatsappLink, waMessages } from "../data/site";
import { footerNav } from "../data/navigation";

const year = new Date().getFullYear();
---

<!--
  El pie es informativo, no promocional: cada página ya tiene su propia
  llamada a la acción y repetirla aquí sólo generaba ruido.
-->
<footer class="border-t border-subtle bg-surface-sunken">
  <div class="container-site grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-12">
    <!-- Marca -->
    <div class="sm:col-span-2 lg:col-span-4">
      <div class="flex items-center gap-3">
        <Image src={logo} alt="" width={112} height={112} densities={[1, 2]} quality={80} class="size-14 rounded-full object-cover" />
        <span class="flex flex-col leading-tight">
          <span class="text-lg font-semibold tracking-tight text-content">{site.shortName}</span>
          <span class="text-2xs uppercase tracking-[0.2em] text-content-subtle">{site.tagline}</span>
        </span>
      </div>

      <p class="mt-6 max-w-xs text-sm leading-relaxed text-content-muted">
        Un refugio campestre en el norte de Nicaragua, a pocos minutos del
        centro de Jalapa.
      </p>

      <div class="mt-6 flex gap-2">
        <a
          href={contact.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Seguinos en Facebook"
          class="flex size-10 items-center justify-center rounded-full border border-subtle text-content-muted transition-colors hover:border-strong hover:text-content"
        >
          <Icon name="facebook" class="size-4.5" />
        </a>
        <a
          href={whatsappLink(waMessages.general)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Escribinos por WhatsApp"
          class="flex size-10 items-center justify-center rounded-full border border-subtle text-content-muted transition-colors hover:border-strong hover:text-content"
        >
          <Icon name="whatsapp" class="size-4.5" />
        </a>
        <a
          href={`mailto:${contact.email}`}
          aria-label="Enviarnos un correo"
          class="flex size-10 items-center justify-center rounded-full border border-subtle text-content-muted transition-colors hover:border-strong hover:text-content"
        >
          <Icon name="mail" class="size-4.5" />
        </a>
      </div>
    </div>

    <!-- Enlaces -->
    {footerNav.map((group) => (
      <nav aria-label={group.title} class="lg:col-span-2">
        <h2 class="text-2xs font-semibold uppercase tracking-[0.16em] text-content-subtle">
          {group.title}
        </h2>
        <ul class="mt-5 space-y-2.5">
          {group.links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-content-muted underline-offset-4 transition-colors hover:text-content hover:underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}

    <!-- Contacto -->
    <div class="lg:col-span-3">
      <h2 class="text-2xs font-semibold uppercase tracking-[0.16em] text-content-subtle">Contacto</h2>
      <ul class="mt-5 space-y-3 text-sm">
        <li class="flex items-start gap-2.5">
          <Icon name="pin" class="mt-0.5 size-4 shrink-0 text-forest-700" />
          <a
            href={contact.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-content-muted underline-offset-4 transition-colors hover:text-content hover:underline"
          >
            {contact.addressLine}
          </a>
        </li>
        <li class="flex items-start gap-2.5">
          <Icon name="phone" class="mt-0.5 size-4 shrink-0 text-forest-700" />
          <a
            href={`tel:${contact.phoneRaw}`}
            class="text-content-muted underline-offset-4 transition-colors hover:text-content hover:underline"
          >
            {contact.phone}
          </a>
        </li>
        <li class="flex items-start gap-2.5">
          <Icon name="mail" class="mt-0.5 size-4 shrink-0 text-forest-700" />
          <a
            href={`mailto:${contact.email}`}
            class="break-all text-content-muted underline-offset-4 transition-colors hover:text-content hover:underline"
          >
            {contact.email}
          </a>
        </li>
      </ul>
    </div>

    <!-- Horarios -->
    <div class="lg:col-span-3">
      <h2 class="text-2xs font-semibold uppercase tracking-[0.16em] text-content-subtle">Horarios</h2>
      <ul class="mt-5 space-y-3 text-sm">
        <li>
          <span class="block font-medium text-content">{hours.restaurant.label}</span>
          {hours.restaurant.schedule.map((slot) => (
            <span class="block text-content-muted">
              {slot.days}: {slot.value}
            </span>
          ))}
        </li>
        <li>
          <span class="block font-medium text-content">Mensajes</span>
          <span class="text-content-muted">
            Respondemos hasta las {hours.messagesUntil}
          </span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-subtle">
    <div class="container-site flex flex-col items-center justify-between gap-2 py-5 text-xs text-content-subtle sm:flex-row">
      <p>© {year} {site.name}</p>
      <p class="flex items-center gap-4">
        <a href="/privacidad" class="underline-offset-4 transition-colors hover:text-content hover:underline">
          Privacidad
        </a>
        <span>Jalapa, Nueva Segovia · Nicaragua</span>
      </p>
    </div>
  </div>
</footer>
