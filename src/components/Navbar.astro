---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

import Icon from "./ui/Icon.astro";
import { mainNav } from "../data/navigation";
import { site, whatsappLink, waMessages } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
/** En la portada el navbar arranca transparente sobre el hero. */
const overHero = path === "/";

const isActive = (href: string) => path === href;
const isBranchActive = (item: (typeof mainNav)[number]) =>
  isActive(item.href) || (item.children?.some((c) => isActive(c.href)) ?? false);
---

<header
  id="navbar"
  data-over-hero={overHero ? "true" : "false"}
  class:list={[
    "fixed inset-x-0 top-0 z-50 border-b transition-colors duration-300",
    overHero ? "border-transparent bg-transparent" : "border-subtle bg-surface",
  ]}
>
  <div class="container-site">
    <div class="flex h-20 items-center justify-between gap-4 md:h-24">
      <a href="/" class="flex shrink-0 items-center gap-3" aria-label={`${site.name}, ir al inicio`}>
        <Image
          src={logo}
          alt=""
          width={128}
          height={128}
          densities={[1, 2]}
          quality={80}
          loading="eager"
          class="size-14 rounded-full object-cover md:size-16"
        />
        <span class="flex flex-col leading-none">
          <span class="nav-brand text-lg font-semibold tracking-tight transition-colors">
            {site.shortName}
          </span>
          <span class="nav-brand-sub mt-1 text-2xs uppercase tracking-[0.2em] transition-colors">
            {site.tagline}
          </span>
        </span>
      </a>

      <nav aria-label="Navegación principal" class="ml-auto hidden items-center lg:flex">
        {mainNav.map((item) =>
          item.children ? (
            <div class="group/drop relative">
              <button
                type="button"
                class:list={[
                  "nav-item nav-underline flex items-center gap-1.5 px-4 py-2.5 text-[0.9375rem] transition-colors",
                  isBranchActive(item) && "is-active",
                ]}
                aria-expanded="false"
                aria-haspopup="true"
              >
                {item.label}
                <Icon
                  name="chevron-down"
                  class="size-3.5 transition-transform duration-200 group-hover/drop:rotate-180"
                />
              </button>

              <div class="invisible absolute left-0 top-full w-72 translate-y-1 pt-2 opacity-0 transition-[opacity,transform,visibility] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-focus-within/drop:visible group-focus-within/drop:translate-y-0 group-focus-within/drop:opacity-100 group-hover/drop:visible group-hover/drop:translate-y-0 group-hover/drop:opacity-100">
                <div class="overflow-hidden rounded-panel border border-subtle bg-surface-raised shadow-raised">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      aria-current={isActive(child.href) ? "page" : undefined}
                      class:list={[
                        "flex items-start gap-3 border-b border-subtle p-4 transition-colors last:border-b-0 hover:bg-surface-sunken",
                        isActive(child.href) && "bg-surface-sunken",
                      ]}
                    >
                      <Icon name={child.icon} class="mt-0.5 size-4.5 shrink-0 text-forest-700" />
                      <span class="flex flex-col">
                        <span class="text-[0.9375rem] font-medium text-content">{child.label}</span>
                        <span class="mt-0.5 text-xs leading-snug text-content-subtle">
                          {child.description}
                        </span>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "nav-item nav-underline px-4 py-2.5 text-[0.9375rem] transition-colors",
                isActive(item.href) && "is-active",
              ]}
            >
              {item.label}
            </a>
          )
        )}
      </nav>

      <div class="flex items-center gap-1">
        <a
          href={whatsappLink(waMessages.room)}
          target="_blank"
          rel="noopener noreferrer"
          class="nav-cta ml-2 hidden rounded-full px-5 py-2.5 text-sm font-medium transition-colors lg:inline-flex"
        >
          Reservar
        </a>

        <button
          id="menu-toggle"
          type="button"
          class="nav-item rounded-full p-2.5 transition-colors lg:hidden"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="close" class="hidden size-6 [[aria-expanded='true']_&]:block" />
          <Icon name="menu" class="size-6 [[aria-expanded='true']_&]:hidden" />
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" hidden class="border-t border-subtle bg-surface lg:hidden">
    <nav aria-label="Navegación móvil" class="container-site max-h-[calc(100svh-6rem)] overflow-y-auto py-4">
      <ul class="flex flex-col">
        {mainNav.map((item) =>
          item.children ? (
            <li>
              <p class="px-1 pb-2 pt-5 text-2xs font-semibold uppercase tracking-[0.16em] text-content-subtle">
                {item.label}
              </p>
              <ul class="flex flex-col">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={isActive(child.href) ? "page" : undefined}
                      class:list={[
                        "flex items-center gap-3 border-b border-subtle px-1 py-3.5 transition-colors",
                        isActive(child.href) ? "text-content-accent" : "text-content",
                      ]}
                    >
                      <Icon name={child.icon} class="size-5 shrink-0 text-content-subtle" />
                      <span class="flex flex-col">
                        <span class="font-medium">{child.label}</span>
                        <span class="text-xs text-content-subtle">{child.description}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "block border-b border-subtle px-1 py-4 text-base transition-colors",
                  isActive(item.href) ? "font-medium text-content-accent" : "text-content",
                ]}
              >
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>

      <a
        href={whatsappLink(waMessages.room)}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 flex items-center justify-center gap-2.5 rounded-full bg-action px-6 py-3.5 font-medium text-action-content"
      >
        <Icon name="whatsapp" class="size-5" />
        Reservar por WhatsApp
      </a>
    </nav>
  </div>
</header>

{!overHero && <div class="h-20 md:h-24" aria-hidden="true"></div>}

<style>
  /* El color del navbar depende de si flota sobre el hero. Resuelto en CSS,
     sin manipular clases desde JavaScript. */
  #navbar[data-over-hero="true"]:not(.is-scrolled) :global(.nav-item),
  #navbar[data-over-hero="true"]:not(.is-scrolled) :global(.nav-brand) {
    color: #ffffff;
  }

  #navbar[data-over-hero="true"]:not(.is-scrolled) :global(.nav-brand-sub) {
    color: rgb(255 255 255 / 0.6);
  }

  #navbar[data-over-hero="true"]:not(.is-scrolled) :global(.nav-cta) {
    background-color: #ffffff;
    color: var(--color-ink-950);
  }

  #navbar[data-over-hero="true"]:not(.is-scrolled) :global(.nav-cta:hover) {
    background-color: var(--color-ink-100);
  }

  #navbar:not([data-over-hero="true"]) :global(.nav-item),
  #navbar.is-scrolled :global(.nav-item) {
    color: var(--content-muted);
  }

  #navbar:not([data-over-hero="true"]) :global(.nav-item:hover),
  #navbar.is-scrolled :global(.nav-item:hover) {
    color: var(--content);
  }

  #navbar:not([data-over-hero="true"]) :global(.nav-brand),
  #navbar.is-scrolled :global(.nav-brand) {
    color: var(--content);
  }

  #navbar:not([data-over-hero="true"]) :global(.nav-brand-sub),
  #navbar.is-scrolled :global(.nav-brand-sub) {
    color: var(--content-subtle);
  }

  #navbar:not([data-over-hero="true"]) :global(.nav-item.is-active),
  #navbar.is-scrolled :global(.nav-item.is-active) {
    color: var(--content);
    font-weight: 500;
  }

  #navbar:not([data-over-hero="true"]) :global(.nav-cta),
  #navbar.is-scrolled :global(.nav-cta) {
    background-color: var(--action);
    color: var(--action-content);
  }

  #navbar:not([data-over-hero="true"]) :global(.nav-cta:hover),
  #navbar.is-scrolled :global(.nav-cta:hover) {
    background-color: var(--action-hover);
  }

  #navbar.is-scrolled {
    background-color: var(--surface);
    border-bottom-color: var(--border-subtle);
  }

  #mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #mobile-menu > * {
    overflow: hidden;
    min-height: 0;
  }
  #mobile-menu.is-open {
    grid-template-rows: 1fr;
  }
</style>

<script>
  const navbar = document.getElementById("navbar");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  let ticking = false;
  const syncNavbar = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      navbar?.classList.toggle("is-scrolled", window.scrollY > 40);
      ticking = false;
    });
  };
  window.addEventListener("scroll", syncNavbar, { passive: true });
  syncNavbar();

  const setMenu = (open: boolean) => {
    if (!mobileMenu || !menuToggle) return;
    menuToggle.setAttribute("aria-expanded", String(open));
    menuToggle.setAttribute(
      "aria-label",
      open ? "Cerrar menú de navegación" : "Abrir menú de navegación"
    );
    if (open) {
      mobileMenu.hidden = false;
      void mobileMenu.offsetHeight;
      mobileMenu.classList.add("is-open");
      navbar?.classList.add("is-scrolled");
    } else {
      mobileMenu.classList.remove("is-open");
      mobileMenu.addEventListener(
        "transitionend",
        () => {
          if (!mobileMenu.classList.contains("is-open")) mobileMenu.hidden = true;
        },
        { once: true }
      );
      syncNavbar();
    }
  };

  menuToggle?.addEventListener("click", () => {
    setMenu(menuToggle.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menuToggle?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      menuToggle.focus();
    }
  });

  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });

</script>
