---
import Icon from "../ui/Icon.astro";
import Media from "../ui/Media.astro";
import Button from "../ui/Button.astro";
import type { IconName } from "../ui/icons";

const facts: { icon: IconName; term: string; desc: string }[] = [
  { icon: "clock", term: "Restaurante", desc: "1 PM – 10 PM" },
  { icon: "guests", term: "Eventos", desc: "Hasta 400" },
  { icon: "wifi", term: "Wi-Fi", desc: "Cortesía" },
  { icon: "parking", term: "Parqueo", desc: "Incluido" },
];
---

<section class="relative flex min-h-[100svh] items-end overflow-hidden bg-ink-950">
  <!-- La imagen se amplía muy despacio durante medio minuto: la escena
       respira sin que el movimiento llegue a distraer. -->
  <Media
    src="/images/hero/hotel-pantano-nocturno.webp"
    alt="Los jardines iluminados de Hotel El Pantano al anochecer, en Jalapa, Nueva Segovia"
    sizes="100vw"
    priority
    class="hero-drift absolute inset-0 size-full object-cover"
  />
  <div class="scrim absolute inset-0"></div>

  <div class="container-site relative z-10 pb-20 pt-36 md:pb-28">
    <div class="max-w-3xl">
      <p class="animate-rise-in kicker text-gold-400">Jalapa · Nueva Segovia</p>

      <h1 class="animate-rise-in text-display mt-6 text-white [animation-delay:100ms]">
        El campo, como se recuerda.
      </h1>

      <p class="animate-rise-in text-lead mt-7 max-w-xl text-white/75 [animation-delay:200ms]">
        Cabañas entre jardines, cocina nicaragüense hecha en casa y espacio para
        celebrar lo que importa. A pocos minutos del centro de Jalapa, a un
        mundo de distancia del ruido.
      </p>

      <div class="animate-rise-in mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 [animation-delay:300ms]">
        <Button href="/habitaciones" variant="light" size="lg" icon="arrow-right">
          Ver habitaciones
        </Button>
        <a
          href="/menu"
          class="link-underline text-[0.9375rem] text-white/75 transition-colors hover:text-white"
        >
          o conocé el menú del restaurante
        </a>
      </div>

      <dl class="animate-rise-in mt-14 grid max-w-2xl grid-cols-2 gap-3 sm:grid-cols-4 [animation-delay:400ms]">
        {facts.map((fact) => (
          <div class="flex items-center gap-3 rounded-xl border border-white/15 bg-white/8 px-4 py-3.5">
            <Icon name={fact.icon} class="size-4.5 shrink-0 text-gold-400" />
            <div>
              <dt class="text-2xs uppercase tracking-[0.14em] text-white/55">{fact.term}</dt>
              <dd class="text-sm text-white">{fact.desc}</dd>
            </div>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
