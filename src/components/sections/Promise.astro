---
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Media from "../ui/Media.astro";
import Icon from "../ui/Icon.astro";
import type { IconName } from "../ui/icons";

const pillars: { icon: IconName; label: string; title: string; text: string; image: string; alt: string }[] = [
  {
    icon: "nature",
    label: "Para los niños",
    title: "Espacio para correr",
    text: "Áreas verdes amplias, columpios y lugar de sobra. Un entorno seguro donde los papás pueden bajar la guardia un rato.",
    image: "/images/habitaciones/zona-recreativa-columpios.webp",
    alt: "Zona recreativa con columpios rodeada de áreas verdes en Hotel El Pantano",
  },
  {
    icon: "leaf",
    label: "Para los adultos",
    title: "Calma de verdad",
    text: "El sonido del campo en lugar del tráfico. Sombra, jardines y un servicio que atiende sin interrumpir la conversación.",
    image: "/images/hero/jardin-panoramico-arcoiris.webp",
    alt: "Vista panorámica de los jardines de Hotel El Pantano",
  },
  {
    icon: "coffee",
    label: "Para todos",
    title: "La mesa que reúne",
    text: "Desde las micheladas que ya son parte del vocabulario local hasta las alitas y los tostones. Donde termina cualquier plan.",
    image: "/images/restaurante/reunion-familiar.webp",
    alt: "Familias compartiendo la mesa en el restaurante de Hotel El Pantano",
  },
];
---

<Section id="promesa" tone="surface">
  <SectionHeading
    kicker="Por qué venir"
    title="Tres razones por las que la gente vuelve"
    lead="No es un hotel de paso: la mayoría de quienes llegan un fin de semana regresan al siguiente."
  />

  <div class="mt-14 grid gap-6 md:grid-cols-3" data-reveal-group>
    {pillars.map((pillar) => (
      <article class="card-interactive group flex flex-col overflow-hidden">
        <div class="card-media aspect-4/3" data-reveal-media>
          <Media
            src={pillar.image}
            alt={pillar.alt}
            widths={[400, 600, 800]}
            sizes="(min-width: 768px) 33vw, 100vw"
            class="size-full object-cover"
          />
        </div>

        <div class="flex flex-1 flex-col p-7">
          <p class="flex items-center gap-2.5 text-2xs font-semibold uppercase tracking-[0.14em] text-content-subtle">
            <Icon name={pillar.icon} class="size-4 text-forest-700" />
            {pillar.label}
          </p>
          <h3 class="text-h3 mt-3">{pillar.title}</h3>
          <p class="mt-3 text-content-muted">{pillar.text}</p>
        </div>
      </article>
    ))}
  </div>
</Section>
