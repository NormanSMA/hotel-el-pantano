---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import Media from "../ui/Media.astro";
import { roomAmenities, roomRates } from "../../data/rooms";
import { formatPrice } from "../../data/menu";

const featured = roomAmenities.slice(0, 4);
const from = roomRates[0].price;
---

<Section tone="surface">
  <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7" data-reveal="left">
      <div class="card-media aspect-16/10 rounded-media" data-reveal-media>
        <Media
          src="/images/habitaciones/interior-habitacion.webp"
          alt="Interior de una cabaña de Hotel El Pantano, con cama matrimonial y luz natural"
          widths={[600, 900, 1200]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          class="size-full object-cover"
        />
      </div>
    </div>

    <div class="lg:col-span-5" data-reveal="right">
      <p class="kicker mb-5">Hospedaje</p>

      <h2 class="text-h2">Dormí con la ventana abierta</h2>

      <p class="text-lead mt-5 text-content-muted">
        Cabañas sencillas y limpias, con lo necesario para descansar de verdad:
        agua caliente, buena cama y el silencio del campo.
      </p>

      <ul class="card mt-8 space-y-3 p-6">
        {featured.map((amenity) => (
          <li class="flex items-center gap-3 text-[0.9375rem] text-content">
            <Icon name={amenity.icon} class="size-4.5 shrink-0 text-content-subtle" />
            {amenity.label}
          </li>
        ))}
      </ul>

      <p class="mt-6">
        <span class="text-2xs uppercase tracking-[0.14em] text-content-subtle">Desde</span>
        <span class="ml-2 text-2xl font-semibold tabular-nums text-content">{formatPrice(from)}</span>
        <span class="text-content-subtle"> por noche</span>
      </p>

      <div class="mt-7">
        <Button href="/habitaciones" variant="solid" icon="arrow-right">
          Ver la habitación
        </Button>
      </div>
    </div>
  </div>
</Section>
