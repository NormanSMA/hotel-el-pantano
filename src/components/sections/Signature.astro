---
import Section from "../ui/Section.astro";
import SplitText from "../ui/SplitText.astro";
import Media from "../ui/Media.astro";
import Button from "../ui/Button.astro";
import { signatureDishes, formatPrice } from "../../data/menu";
---

<Section tone="sunken">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-2xl">
      <p class="kicker mb-5" data-reveal>Lo más pedido</p>
      <SplitText as="h2" text="Los favoritos de la casa" trigger="view" class="text-h2" />
      <p class="text-lead mt-5 text-content-muted" data-reveal>
        Los platos que la gente pide sin ver el menú. Si es tu primera vez, empezá por acá.
      </p>
    </div>

    <div data-reveal>
      <Button href="/menu" variant="outline" size="sm" icon="arrow-right" magnetic>
        Ver el menú completo
      </Button>
    </div>
  </div>

  <div class="mt-16 grid gap-8 md:mt-20 md:grid-cols-3" data-reveal-group>
    {signatureDishes.map((dish) => (
      <article class="card-interactive group flex flex-col overflow-hidden">
        <div class="card-media aspect-4/3" data-reveal-media>
          <Media
            src={dish.image}
            alt={`${dish.name}, del restaurante de Hotel El Pantano`}
            widths={[400, 600, 800]}
            sizes="(min-width: 768px) 33vw, 100vw"
            class="size-full object-cover"
          />
        </div>

        <div class="flex flex-1 flex-col p-7">
          <p class="text-2xs font-semibold uppercase tracking-[0.14em] text-content-subtle">
            {dish.tag}
          </p>
          <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
            <h3 class="text-h3">{dish.name}</h3>
            <span class="shrink-0 text-lg font-semibold tabular-nums text-content">
              {formatPrice(dish.price)}
            </span>
          </div>
          <p class="mt-3 text-content-muted">{dish.description}</p>
        </div>
      </article>
    ))}
  </div>
</Section>
