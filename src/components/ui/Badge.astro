---
import Icon from "./Icon.astro";
import type { IconName } from "./icons";

interface Props {
  /** `accent` es el único uso de dorado en toda la interfaz: resérvese. */
  variant?: "neutral" | "accent" | "inverse";
  icon?: IconName;
  class?: string;
}

const { variant = "neutral", icon, class: className = "" }: Props = Astro.props;

const variants = {
  neutral: "border border-default text-content-muted",
  accent: "border border-gold-400 text-gold-800",
  inverse: "border border-white/30 text-white",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-2xs font-semibold uppercase tracking-[0.14em]",
    variants[variant],
    className,
  ]}
>
  {icon && <Icon name={icon} class="size-3.5" />}
  <slot />
</span>
