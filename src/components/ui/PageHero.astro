---
import Media from "./Media.astro";
import SplitText from "./SplitText.astro";

interface Props {
  /** Calidad AVIF de la foto. Bajarla sólo en fotos muy detalladas (follaje). */
  imageQuality?: number;
  eyebrow?: string;
  title: string;
  lead?: string;
  image: string;
  imageAlt: string;
  size?: "full" | "compact";
}

const {
  eyebrow,
  title,
  lead,
  image,
  imageAlt,
  size = "compact",
  imageQuality,
}: Props = Astro.props;
---

<section
  class:list={[
    "relative flex items-end overflow-hidden bg-ink-950",
    // En móvil el hero llena casi toda la pantalla: el primer vistazo es sólo
    // la foto y ninguna otra imagen compite con ella al cargar.
    size === "full" ? "min-h-[100svh]" : "min-h-[88svh] md:min-h-[72svh]",
  ]}
>
  <!-- La foto viaja entre páginas (view transition) y se desplaza más lenta
       que el texto al hacer scroll. -->
  <div class="parallax-frame vt-hero-media absolute inset-0">
    <div data-parallax="0.24">
      <Media
        src={image}
        alt={imageAlt}
        sizes="100vw"
        priority
        quality={imageQuality}
        class="hero-drift size-full object-cover"
      />
    </div>
  </div>
  <div class="scrim absolute inset-0"></div>

  <div class="container-site relative z-10 pb-16 pt-36 md:pb-24 md:pt-44" data-fade-out>
    <div class="max-w-4xl">
      {eyebrow && (
        <p class="animate-rise-in kicker mb-6 text-gold-400">
          {eyebrow}
        </p>
      )}

      <SplitText
        as="h1"
        text={title}
        trigger="now"
        delay={120}
        class:list={["text-white", size === "full" ? "text-display" : "text-h1"]}
      />

      {lead && (
        <p class="animate-rise-soft text-lead mt-8 max-w-xl text-white/80 [animation-delay:150ms]">
          {lead}
        </p>
      )}

      <div class="animate-rise-in mt-10 empty:mt-0 [animation-delay:600ms]">
        <slot />
      </div>
    </div>
  </div>
</section>
