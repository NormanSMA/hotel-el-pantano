---
import Icon from "./Icon.astro";
import { mainNav } from "../../data/navigation";

interface Props {
  /** Ruta actual: se excluye de la lista. */
  current: string;
  title?: string;
}

const { current, title = "Seguí explorando" }: Props = Astro.props;

/**
 * Enlazado interno entre las tres páginas de servicio.
 * Ayuda a quien llega desde una búsqueda concreta a descubrir el resto, y de
 * paso reparte autoridad entre las páginas que interesa posicionar.
 */
const services = mainNav.find((item) => item.children)?.children ?? [];
const others = services.filter((item) => item.href !== current);
---

{
  others.length > 0 && (
    <nav aria-label={title} class="border-t border-subtle bg-surface-sunken">
      <div class="container-site py-14">
        <h2 class="text-2xs font-semibold uppercase tracking-[0.16em] text-content-subtle">
          {title}
        </h2>

        <ul class="mt-6 grid gap-4 sm:grid-cols-2" data-reveal-group>
          {others.map((item) => (
            <li>
              <a href={item.href} class="card-interactive group flex items-center gap-5 p-6">
                <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-surface text-forest-700">
                  <Icon name={item.icon} class="size-5" />
                </span>
                <span class="flex-1">
                  <span class="block font-medium text-content">{item.label}</span>
                  <span class="mt-0.5 block text-sm text-content-subtle">{item.description}</span>
                </span>
                <Icon
                  name="arrow-right"
                  class="size-4 shrink-0 text-content-subtle transition-transform duration-250 group-hover:translate-x-0.5"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}
