---
/**
 * Titular que entra palabra por palabra, cada una desde debajo de su línea.
 *
 * - trigger="now"  → animación CSS inmediata. Para el hero, sin esperar a JS.
 * - trigger="view" → arranca al entrar en pantalla (observador del Layout).
 *
 * El texto completo va en un span sr-only: los lectores de pantalla leen la
 * frase entera y no palabra por palabra. No se usa aria-label porque está
 * prohibido en <p> y <span>.
 */
interface Props {
  text: string;
  as?: "h1" | "h2" | "h3" | "p" | "span";
  trigger?: "now" | "view";
  /** Retardo inicial en milisegundos. */
  delay?: number;
  class?: string;
  id?: string;
}

const { text, as: Tag = "h2", trigger = "view", delay = 0, class: className = "", id }: Props =
  Astro.props;

const words = text.trim().split(/\s+/);
---

<Tag
  id={id}
  class={className}
  data-split={trigger}
  style={`--split-base: ${delay}ms`}
>
  <span class="sr-only">{text}</span>
  {words.map((word, i) => (
    <>
      <span class="split-word" aria-hidden="true">
        <span class="split-inner" style={`--i: ${i}`}>{word}</span>
      </span>
      {i < words.length - 1 && " "}
    </>
  ))}
</Tag>
