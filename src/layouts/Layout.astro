---
// Una sola familia tipográfica, auto-hospedada: sin peticiones a Google Fonts.
import "@fontsource-variable/outfit";
import "../styles/global.css";
// La fuente no se precarga a propósito: competiría con la foto del hero, que
// es el LCP. El CLS ya es 0 con font-display: swap.

import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/ui/Icon.astro";

import { site, contact } from "../data/site";
import { shareCardFor } from "../data/share";
import { graph, organizationSchema, websiteSchema } from "../lib/seo";

interface Props {
  title: string;
  description?: string;
  /** Imagen para compartir. Debe ser 1200x630. */
  image?: string;
  /** Texto alternativo de la imagen para compartir. */
  imageAlt?: string;
  /** Tipo Open Graph. "article" sólo para contenido editorial. */
  ogType?: "website" | "article";
  /** Nodos JSON-LD adicionales propios de la página. */
  schema?: object[];
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  image,
  imageAlt,
  ogType = "website",
  schema = [],
  noindex = false,
  bodyClass = "",
}: Props = Astro.props;

// Google recorta los títulos alrededor de los 60 caracteres, así que el sufijo
// de marca se mantiene corto. Si el título ya nombra la ciudad no se repite:
// "Menú del Restaurante en Jalapa | El Pantano" se lee mejor que repetir Jalapa.
const pageTitle = title.includes(site.shortName)
  ? title
  : title.includes("Jalapa")
    ? `${title} | ${site.shortName}`
    : `${title} | ${site.shortName}, Jalapa`;

// Astro genera las páginas como /menu/index.html, así que las URL canónicas
// llevan barra final igual que las del sitemap. Que ambas coincidan evita que
// Google vea dos direcciones distintas para la misma página.
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, site.url).href;

// Cada página comparte su propia tarjeta (/og/<slug>.jpg, generada en build).
// Una página puede forzar otra imagen con la prop `image`.
const card = shareCardFor(Astro.url.pathname);
const shareImage = image ?? `/og/${card.slug}.jpg`;
const shareAlt = imageAlt ?? card.alt;
const ogImage = shareImage.startsWith("http") ? shareImage : new URL(shareImage, site.url).href;

const jsonLd = graph([organizationSchema, websiteSchema, ...schema]);
---

<!doctype html>
<html lang="es-NI" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />

    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content={site.name} />
    <meta name="geo.region" content="NI-NS" />
    <meta name="geo.placename" content="Jalapa, Nueva Segovia" />
    <meta name="geo.position" content={`${contact.geo.latitude};${contact.geo.longitude}`} />
    <meta name="ICBM" content={`${contact.geo.latitude}, ${contact.geo.longitude}`} />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Vista previa al compartir: WhatsApp, Facebook, Messenger, X, LinkedIn -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={shareAlt} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!--
      Se marca <html class="js"> antes de pintar para que los reveals sólo se
      activen si hay JavaScript. Sin él, el contenido es visible de entrada.
    -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <!-- Google Analytics: se carga tras la interacción para no penalizar el LCP -->
    <script is:inline define:vars={{ gaId: "G-MVB82FRY9Q" }}>
      (() => {
        let loaded = false;
        const load = () => {
          if (loaded) return;
          loaded = true;
          const s = document.createElement("script");
          s.async = true;
          s.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag("js", new Date());
          window.gtag("config", gaId, { anonymize_ip: true });
        };
        ["pointerdown", "keydown", "scroll", "touchstart"].forEach((evt) =>
          window.addEventListener(evt, load, { once: true, passive: true })
        );
        setTimeout(load, 4000);
      })();
    </script>
  </head>

  <body class:list={["flex min-h-svh flex-col bg-surface text-content", bodyClass]}>
    <a
      href="#contenido"
      class="sr-only-focusable fixed left-4 top-4 z-[100] rounded-full bg-action px-5 py-3 text-sm font-semibold text-action-content"
    >
      Saltar al contenido
    </a>

    <Navbar />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Footer />

    <button
      id="back-to-top"
      type="button"
      aria-label="Volver arriba"
      class="pointer-events-none fixed bottom-6 right-6 z-40 translate-y-2 rounded-full border border-default bg-surface p-3 text-content opacity-0 shadow-soft transition-[opacity,transform,background-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-surface-sunken motion-reduce:transition-none"
    >
      <Icon name="arrow-up" class="size-4" />
    </button>

    <script>
      // ---- Botón "volver arriba" ------------------------------------------
      const topBtn = document.getElementById("back-to-top");
      let ticking = false;

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const visible = window.scrollY > 600;
          topBtn?.classList.toggle("opacity-0", !visible);
          topBtn?.classList.toggle("translate-y-2", !visible);
          topBtn?.classList.toggle("pointer-events-none", !visible);
          ticking = false;
        });
      };

      window.addEventListener("scroll", onScroll, { passive: true });

      topBtn?.addEventListener("click", () => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (window.__lenis && !reduce) window.__lenis.scrollTo(0, { duration: 1.6 });
        else window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      });

      // ---- Movimiento bajo demanda ----------------------------------------
      // Motion y Lenis se descargan aparte y sólo cuando aportan algo. Se
      // esperan al primer momento libre para no competir con el primer pintado.
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const whenIdle = (fn: () => void) =>
        "requestIdleCallback" in window
          ? window.requestIdleCallback(fn, { timeout: 1500 })
          : setTimeout(fn, 200);

      if (!prefersReduced) {
        whenIdle(() => {
          if (document.querySelector("[data-parallax], [data-fade-out], [data-words], [data-magnetic]")) {
            import("../scripts/motion");
          }
          if (window.matchMedia("(pointer: fine)").matches) {
            import("../scripts/smooth");
          }
        });
      }

      // ---- Reveals al hacer scroll ----------------------------------------
      const revealTargets = document.querySelectorAll<HTMLElement>(
        "[data-reveal], [data-reveal-group], [data-reveal-media], [data-split='view']"
      );

      if (revealTargets.length > 0 && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        revealTargets.forEach((el) => observer.observe(el));

        // Respaldo: el observador puede no avisar si la sección estaba sin
        // pintar (content-visibility) o si Lenis movió el scroll de golpe.
        // Todo lo que ya entró o quedó por encima del borde inferior se
        // muestra, así nada queda oculto para siempre.
        let pending = Array.from(revealTargets);
        let queued = false;
        const sweep = () => {
          queued = false;
          const limit = window.innerHeight * 0.92;
          pending = pending.filter((el) => {
            if (el.classList.contains("is-visible")) return false;
            if (el.getBoundingClientRect().top < limit) {
              el.classList.add("is-visible");
              observer.unobserve(el);
              return false;
            }
            return true;
          });
          if (pending.length === 0) window.removeEventListener("scroll", onSweep);
        };
        const onSweep = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(sweep);
        };
        window.addEventListener("scroll", onSweep, { passive: true });
        window.addEventListener("load", onSweep, { once: true });
      } else {
        revealTargets.forEach((el) => el.classList.add("is-visible"));
      }

      // ---- Contadores ------------------------------------------------------
      // Las cifras grandes suben desde cero al entrar en pantalla. Se anima
      // sólo el número: "20+" cuenta y conserva el signo.
      const counters = document.querySelectorAll<HTMLElement>("[data-count]");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (counters.length > 0 && "IntersectionObserver" in window && !reduceMotion) {
        const run = (el: HTMLElement) => {
          const raw = el.dataset.count || el.textContent || "";
          const target = Number.parseInt(raw.replace(/[^0-9]/g, ""), 10);
          if (!Number.isFinite(target)) return;
          const suffix = raw.replace(/[0-9\s]/g, "");
          const duration = 1100;
          const start = performance.now();

          const tick = (now: number) => {
            const progress = Math.min((now - start) / duration, 1);
            // Desaceleración cúbica: arranca rápido y se asienta
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = String(Math.round(target * eased)) + suffix;
            if (progress < 1) requestAnimationFrame(tick);
          };

          el.textContent = "0" + suffix;
          requestAnimationFrame(tick);
        };

        const counterObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              run(entry.target as HTMLElement);
              counterObserver.unobserve(entry.target);
            }
          },
          { threshold: 0.6 }
        );

        counters.forEach((el) => counterObserver.observe(el));
      }
    </script>

    <Analytics />
    <SpeedInsights />
  </body>
</html>
