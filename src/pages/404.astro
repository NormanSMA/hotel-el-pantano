---
import Layout from "../layouts/Layout.astro";
import SplitText from "../components/ui/SplitText.astro";
import Button from "../components/ui/Button.astro";
import { mainNav } from "../data/navigation";
---

<Layout
  title="Página no encontrada"
  description="La página que buscás no existe o cambió de dirección. Volvé al inicio de Hotel El Pantano o usá los enlaces a habitaciones, restaurante y eventos."
  noindex
>
  <section class="flex min-h-[78svh] items-center bg-surface">
    <div class="container-site py-28 md:py-36">
      <p class="kicker mb-8">Error 404</p>

      <SplitText as="h1" text="Esta página no existe" trigger="now" class="text-display max-w-4xl" />

      <p class="text-lead mt-10 max-w-xl text-content-muted">
        O cambió de dirección. Te dejamos el camino de vuelta.
      </p>

      <div class="mt-12">
        <Button href="/" variant="solid" icon="arrow-right">Volver al inicio</Button>
      </div>

      <nav aria-label="Enlaces útiles" class="mt-24 border-t border-subtle pt-10">
        <ul class="flex flex-wrap gap-x-10 gap-y-4 text-sm">
          {mainNav
            .flatMap((item) => item.children ?? [item])
            .map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-content-muted underline decoration-1 underline-offset-4 transition-colors hover:text-content"
                >
                  {item.label}
                </a>
              </li>
            ))}
        </ul>
      </nav>
    </div>
  </section>
</Layout>
