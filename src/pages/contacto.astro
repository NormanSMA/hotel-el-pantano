---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import MapEmbed from "../components/ui/MapEmbed.astro";
import SplitText from "../components/ui/SplitText.astro";
import { site, contact, hours, whatsappLink, waMessages } from "../data/site";
import { breadcrumbSchema } from "../lib/seo";

const crumbs = [{ label: "Inicio", href: "/" }, { label: "Contacto" }];

const channels = [
  {
    icon: "whatsapp" as const,
    title: "WhatsApp",
    detail: contact.phone,
    hint: `Escribinos hasta las ${hours.messagesUntil} y te respondemos el mismo día.`,
    href: whatsappLink(waMessages.general),
    external: true,
    featured: true,
  },
  {
    icon: "phone" as const,
    title: "Teléfono",
    detail: contact.phone,
    hint: `Atendemos llamadas hasta las ${hours.messagesUntil}.`,
    href: `tel:${contact.phoneRaw}`,
    external: false,
    featured: false,
  },
  {
    icon: "mail" as const,
    title: "Correo",
    detail: contact.email,
    hint: "Para cotizaciones detalladas y facturación.",
    href: `mailto:${contact.email}`,
    external: false,
    featured: false,
  },
  {
    icon: "pin" as const,
    title: "Visitanos",
    detail: contact.addressLine,
    hint: "Parqueo dentro del predio, sin costo.",
    href: contact.mapsUrl,
    external: true,
    featured: false,
  },
];

/** Atajos que ahorran el ida y vuelta de "¿en qué te puedo ayudar?". */
const shortcuts = [
  {
    title: "Reservar una cabaña",
    text: "Decinos las fechas y cuántas personas son.",
    message: waMessages.room,
  },
  {
    title: "Cotizar un evento",
    text: "Fecha, tipo de celebración y número de invitados.",
    message: waMessages.event,
  },
  {
    title: "Reservar mesa o pedir comida",
    text: "Hora de llegada y cuántos son, o tu pedido para llevar.",
    message: waMessages.order,
  },
];

const contactSchema = {
  "@type": "ContactPage",
  "@id": `${site.url}/contacto/#contact`,
  name: "Contacto de Hotel El Pantano",
  about: { "@id": `${site.url}/#organization` },
};
---

<Layout
  title="Contacto y Cómo Llegar"
  description="Contactá a Hotel El Pantano en Jalapa, Nueva Segovia: WhatsApp al +505 8653 8494, correo y ubicación en el mapa. Atendemos hasta las 8:30 PM."
  schema={[breadcrumbSchema(crumbs), contactSchema]}
>
  <PageHero
    eyebrow="Hablemos"
    title="Estamos para servirte"
    lead="Consulta, reservación o cotización. Elegí el canal que te quede más cómodo: todos llegan a la misma gente."
    image="/images/hero/decoracion-rustica-jardin.webp"
    imageAlt="Decoración rústica en los jardines de Hotel El Pantano en Jalapa"
  />

  <!-- Canales -->
  <div class="bg-surface pt-20 md:pt-28">
    <div class="container-site">
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        {channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              {...channel.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
              class:list={[
                "card-interactive group flex h-full flex-col p-8",
                channel.featured && "ring-1 ring-forest-700/25",
              ]}
            >
              <span class="flex size-11 items-center justify-center rounded-full bg-surface-sunken text-forest-700">
                <Icon name={channel.icon} class="size-5" />
              </span>
              <h2 class="mt-5 font-medium text-content">{channel.title}</h2>
              <p class="mt-1 break-words text-sm text-content underline decoration-1 underline-offset-4 group-hover:decoration-2">
                {channel.detail}
              </p>
              <p class="mt-2.5 text-sm leading-snug text-content-subtle">{channel.hint}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Atajos de WhatsApp: sustituyen al formulario con menos fricción -->
  <Section tone="surface">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-24">
      <div class="lg:col-span-5" data-reveal="left">
        <p class="kicker mb-5">Escribinos</p>
        <SplitText text="Contanos qué necesitás" trigger="view" class="text-h2" />
        <p class="text-lead mt-6 text-content-muted">
          Elegí el motivo y se abre WhatsApp con el mensaje empezado. Vos sólo
          agregás los detalles.
        </p>

        <ul class="mt-12 space-y-4" data-reveal-group>
          {shortcuts.map((shortcut) => (
            <li>
              <a
                href={whatsappLink(shortcut.message)}
                target="_blank"
                rel="noopener noreferrer"
                class="card-interactive group flex items-center gap-4 p-5"
              >
                <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-surface-sunken text-forest-700">
                  <Icon name="whatsapp" class="size-5" />
                </span>
                <span class="flex-1">
                  <span class="block font-medium text-content">{shortcut.title}</span>
                  <span class="mt-0.5 block text-sm text-content-subtle">{shortcut.text}</span>
                </span>
                <Icon
                  name="arrow-right"
                  class="size-4 shrink-0 text-content-subtle transition-transform duration-250 group-hover:translate-x-0.5"
                />
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-10 text-sm text-content-muted">
          ¿Preferís el correo?
          <a
            href={`mailto:${contact.email}`}
            class="text-content underline decoration-1 underline-offset-4 hover:text-content-accent"
          >
            {contact.email}
          </a>
        </p>
      </div>

      <div class="lg:col-span-7" data-reveal="right">
        <MapEmbed title="Mapa con la ubicación de Hotel El Pantano en Jalapa, Nueva Segovia" class="aspect-4/3" />

        <div class="card mt-8 p-8 md:p-10">
          <h2 class="text-2xs font-semibold uppercase tracking-[0.16em] text-content-subtle">
            Horarios de atención
          </h2>
          <dl class="mt-6 space-y-6">
            <div>
              <dt class="flex items-center gap-2.5 font-medium text-content">
                <Icon name="clock" class="size-4.5 shrink-0 text-content-subtle" />
                {hours.restaurant.label}
              </dt>
              {hours.restaurant.schedule.map((slot) => (
                <dd class="mt-1 flex justify-between gap-6 ps-7 text-sm text-content-muted">
                  <span>{slot.days}</span>
                  <span class="tabular-nums">{slot.value}</span>
                </dd>
              ))}
            </div>

            <div class="border-t border-subtle pt-6">
              <dt class="flex items-center gap-2.5 font-medium text-content">
                <Icon name="phone" class="size-4.5 shrink-0 text-content-subtle" />
                Llamadas y mensajes
              </dt>
              <dd class="mt-1 ps-7 text-sm text-content-muted">
                Hasta las {hours.messagesUntil}. Después de esa hora te
                respondemos a la mañana siguiente.
              </dd>
            </div>

            <div class="border-t border-subtle pt-6">
              <dt class="flex items-center gap-2.5 font-medium text-content">
                <Icon name="bed" class="size-4.5 shrink-0 text-content-subtle" />
                Llegadas tarde
              </dt>
              <dd class="mt-1 ps-7 text-sm text-content-muted">
                Recibimos a cualquier hora si coordinás la llegada con
                anticipación.
              </dd>
            </div>
          </dl>

          <div class="mt-8 border-t border-subtle pt-8">
            <Button href={contact.mapsUrl} external variant="outline" full icon="map" iconPosition="start">
              Cómo llegar
            </Button>
          </div>
        </div>
      </div>
    </div>
  </Section>
</Layout>
