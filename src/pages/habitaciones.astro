---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import RelatedLinks from "../components/ui/RelatedLinks.astro";
import Media from "../components/ui/Media.astro";
import Lightbox from "../components/ui/Lightbox.astro";
import SplitText from "../components/ui/SplitText.astro";
import { roomAmenities, roomRates, roomGallery, roomFaqs, roomOffer } from "../data/rooms";
import { formatPrice } from "../data/menu";
import { site, whatsappLink, waMessages } from "../data/site";
import { breadcrumbSchema, faqSchema } from "../lib/seo";
import { largeSrc } from "../lib/images";

// El lightbox necesita una URL servible: se resuelve aquí, en el servidor.
const galleryLarge = await Promise.all(roomGallery.map((img) => largeSrc(img.src)));

const crumbs = [{ label: "Inicio", href: "/" }, { label: "Habitaciones" }];

const roomSchema = {
  "@type": "HotelRoom",
  "@id": `${site.url}/habitaciones#habitacion`,
  name: "Habitación Estándar, Cabaña El Pantano",
  description:
    "Cabaña para hasta 3 huéspedes con baño privado, agua caliente, Wi-Fi y acceso a los jardines del hotel.",
  occupancy: { "@type": "QuantitativeValue", maxValue: 3, unitCode: "C62" },
  bed: { "@type": "BedDetails", numberOfBeds: 1, typeOfBed: "Queen" },
  amenityFeature: roomAmenities.map((a) => ({
    "@type": "LocationFeatureSpecification",
    name: a.label,
    value: true,
  })),
  image: roomGallery.map((img) => `${site.url}${img.src}`),
  potentialAction: { "@type": "ReserveAction", target: whatsappLink(waMessages.room) },
  offers: roomRates.map((rate) => ({
    "@type": "Offer",
    name: `Tarifa por noche para ${rate.occupancy}`,
    price: rate.price,
    priceCurrency: "NIO",
    availability: "https://schema.org/InStock",
  })),
};
---

<Layout
  title="Hotel en Jalapa: Cabañas y Habitaciones"
  description="Cabañas en Jalapa, Nueva Segovia desde C$500 la noche: baño con agua caliente, Wi-Fi, parqueo y jardines. 15% de descuento desde 3 noches."
  schema={[breadcrumbSchema(crumbs), roomSchema, faqSchema(roomFaqs)]}
>
  <PageHero
    eyebrow="Alojamiento"
    title="Cabañas entre jardines"
    lead="Lo esencial, bien hecho: cama cómoda, agua caliente y el silencio del campo. Sin lujos innecesarios ni sorpresas en la factura."
    image="/images/habitaciones/cabanas-exterior-nocturno.webp"
    imageAlt="Las cabañas de El Pantano iluminadas al anochecer"
  />

  <!-- Galería + detalle -->
  <Section tone="surface">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7" data-reveal>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          <button
            type="button"
            class="card-media col-span-2 aspect-16/10 rounded-media sm:col-span-4"
            data-reveal-media
            data-lightbox
            data-lightbox-src={galleryLarge[0]}
            data-lightbox-alt={roomGallery[0].alt}
            aria-label={`Ampliar: ${roomGallery[0].alt}`}
          >
            <Media
              src={roomGallery[0].src}
              alt={roomGallery[0].alt}
              widths={[600, 900, 1200]}
              sizes="(min-width: 1024px) 56vw, 100vw"
              class="size-full object-cover"
            />
          </button>

          {roomGallery.slice(1).map((img, i) => (
            <button
              type="button"
              class="card-media group aspect-4/3 rounded-media"
              data-lightbox
              data-lightbox-src={galleryLarge[i + 1]}
              data-lightbox-alt={img.alt}
              aria-label={`Ampliar: ${img.alt}`}
            >
              <Media
                src={img.src}
                alt={img.alt}
                widths={[240, 360, 480]}
                sizes="(min-width: 1024px) 14vw, (min-width: 640px) 20vw, 45vw"
                class="size-full object-cover"
              />
            </button>
          ))}
        </div>
        <p class="mt-3 text-xs text-content-subtle">Tocá cualquier foto para verla en grande</p>
      </div>

      <div class="lg:col-span-5" data-reveal="right">
        <p class="kicker mb-5">Habitación estándar</p>

        <SplitText as="h2" text="Tu cabaña" trigger="view" class="text-h2" />

        <p class="text-lead mt-5 text-content-muted">
          Cada cabaña tiene acceso independiente desde el jardín. Adentro, lo
          necesario para descansar. Afuera, los jardines, el restaurante y el
          área de juegos.
        </p>

        <h3 class="mt-10 text-2xs font-semibold uppercase tracking-[0.16em] text-content-subtle">
          Incluye
        </h3>
        <ul class="card mt-4 grid gap-2.5 p-6 sm:grid-cols-2">
          {roomAmenities.map((amenity) => (
            <li class="flex items-center gap-2.5 text-[0.9375rem] text-content">
              <Icon name={amenity.icon} class="size-4 shrink-0 text-content-subtle" />
              {amenity.label}
            </li>
          ))}
        </ul>

        <h3 class="mt-10 text-2xs font-semibold uppercase tracking-[0.16em] text-content-subtle">
          Tarifas por noche
        </h3>
        <table class="mt-4 w-full">
          <caption class="sr-only">Precios por noche según número de huéspedes</caption>
          <tbody>
            {roomRates.map((rate) => (
              <tr class="border-b border-subtle last:border-b-0">
                <th scope="row" class="py-3 text-start font-normal text-content-muted">
                  {rate.occupancy}
                </th>
                <td class="py-3 text-end text-lg font-semibold tabular-nums text-content">
                  {formatPrice(rate.price)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <p class="mt-5 flex items-start gap-2.5 rounded-xl bg-surface-sunken p-4 text-sm text-content-muted">
          <Icon name="tag" class="mt-0.5 size-4 shrink-0 text-gold-600" />
          <span>
            {roomOffer.headline} {roomOffer.subline}.
            <button
              type="button"
              id="offer-trigger"
              class="underline decoration-1 underline-offset-4 transition-colors hover:text-content"
            >
              Ver condiciones
            </button>
          </span>
        </p>

        <p class="mt-4 text-xs leading-relaxed text-content-subtle">
          Check-in desde las 2:00 PM · Check-out hasta las 12:00 MD. Las tarifas
          no incluyen desayuno; el restaurante abre temprano.
        </p>

        <div class="mt-10">
          <Button
            href={whatsappLink(waMessages.room)}
            external
            variant="solid"
            size="lg"
            full
            icon="whatsapp"
            iconPosition="start"
            magnetic
          >
            Consultar disponibilidad
          </Button>
        </div>
      </div>
    </div>
  </Section>

  <!-- Preguntas frecuentes: cierre informativo de la página -->
  <Section tone="sunken" width="prose">
    <div data-reveal>
      <SplitText as="h2" text="Preguntas frecuentes" trigger="view" class="text-h2" />
      <p class="text-lead mt-4 text-content-muted">
        Lo que más nos consultan por WhatsApp, resuelto de una vez.
      </p>
    </div>

    <div class="card mt-12 px-7 md:px-8" data-reveal-group>
      {roomFaqs.map((faq) => (
        <details class="accordion group border-b border-subtle last:border-b-0">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium text-content transition-colors hover:text-content-accent [&::-webkit-details-marker]:hidden">
            {faq.q}
            <Icon
              name="chevron-down"
              class="size-4 shrink-0 text-content-subtle transition-transform duration-200 group-open:rotate-180"
            />
          </summary>
          <div class="pb-5 text-content-muted">{faq.a}</div>
        </details>
      ))}
    </div>

    <p class="mt-8 text-sm text-content-muted">
      ¿Falta la tuya?
      <a
        href={whatsappLink(waMessages.general)}
        target="_blank"
        rel="noopener noreferrer"
        class="text-content underline decoration-1 underline-offset-4 hover:text-content-accent"
      >
        Escribinos por WhatsApp
      </a>
    </p>
  </Section>

  <RelatedLinks current="/habitaciones" />

  <!-- Modal de condiciones de la oferta -->
  <dialog
    id="offer-modal"
    aria-labelledby="offer-title"
    class="m-auto w-[92%] max-w-lg rounded-panel border border-subtle bg-surface-raised p-0 text-content shadow-float backdrop:bg-ink-950/70"
  >
    <div class="p-7 md:p-9">
      <div class="flex items-start justify-between gap-4 border-b border-subtle pb-5">
        <h2 id="offer-title" class="text-h3">{roomOffer.badge}</h2>
        <button
          type="button"
          id="offer-close"
          aria-label="Cerrar"
          class="-m-2 p-2 text-content-subtle transition-colors hover:text-content"
        >
          <Icon name="close" class="size-5" />
        </button>
      </div>

      <p class="mt-6 text-3xl font-semibold text-content">{roomOffer.headline}</p>
      <p class="mt-1 text-content-muted">{roomOffer.subline}</p>

      <ul class="mt-7 space-y-2.5 border-t border-subtle pt-6">
        {roomOffer.terms.map((term) => (
          <li class="flex gap-2.5 text-sm text-content-muted">
            <Icon name="check" class="mt-0.5 size-4 shrink-0 text-content-subtle" />
            {term}
          </li>
        ))}
      </ul>

      <div class="mt-8">
        <Button href={whatsappLink(waMessages.offer)} external variant="solid" full>
          Reservar con descuento
        </Button>
      </div>
    </div>
  </dialog>

  <Lightbox />

  <script>
    const modal = document.getElementById("offer-modal") as HTMLDialogElement | null;
    document.getElementById("offer-trigger")?.addEventListener("click", () => modal?.showModal());
    document.getElementById("offer-close")?.addEventListener("click", () => modal?.close());
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });
  </script>
</Layout>
