---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import Media from "../components/ui/Media.astro";
import RelatedLinks from "../components/ui/RelatedLinks.astro";
import { timeline, values } from "../data/history";
import { site, whatsappLink, waMessages } from "../data/site";
import { breadcrumbSchema } from "../lib/seo";

const crumbs = [{ label: "Inicio", href: "/" }, { label: "Nuestra Historia" }];
const years = new Date().getFullYear() - site.foundedYear;

const aboutSchema = {
  "@type": "AboutPage",
  "@id": `${site.url}/historia#about`,
  name: "La historia de Hotel El Pantano",
  about: { "@id": `${site.url}/#organization` },
  mainEntity: {
    "@type": "Person",
    name: "Wilhelmus Johannes Maria",
    jobTitle: "Fundador",
    description:
      "Fundador de Hotel & Restaurante El Pantano en Jalapa, Nueva Segovia, Nicaragua.",
  },
};
---

<Layout
  title="Nuestra Historia"
  description={`Desde ${site.foundedYear}: la historia de El Pantano en Jalapa, el sueño de Wilhelmus Johannes Maria hecho el referente campestre de Nueva Segovia.`}
  schema={[breadcrumbSchema(crumbs), aboutSchema]}
>
  <PageHero
    eyebrow={`Desde ${site.foundedYear}`}
    title="Un legado que florece"
    lead="El sueño de un hombre, sostenido por el trabajo de una familia y la gente de Jalapa."
    image="/images/hero/hotel-pantano-exterior.webp"
    imageAlt="Vista exterior de Hotel El Pantano rodeado de vegetación"
    breadcrumbs={crumbs}
  />

  <!-- El origen -->
  <Section tone="surface">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal="left">
        <figure class="m-0">
          <div class="card-media aspect-4/5 rounded-media" data-reveal-media>
            <Media
              src="/images/historia/fundador-seated.webp"
              alt="Wilhelmus Johannes Maria, fundador de Hotel El Pantano, sentado en los jardines"
              widths={[400, 600, 900]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              class="size-full object-cover"
            />
          </div>
          <figcaption class="mt-3 text-xs text-content-subtle">
            El fundador, en los jardines que levantó.
          </figcaption>
        </figure>
      </div>

      <div class="lg:col-span-7" data-reveal="right">
        <p class="kicker mb-5">El origen</p>

        <h2 class="text-h2">El legado de un sueño</h2>

        <div class="text-lead mt-6 space-y-5 text-content-muted">
          <p>
            Todo empezó con un viaje y un amor profundo por Nicaragua.
            <strong class="font-semibold text-content">Wilhelmus Johannes Maria</strong>,
            un holandés con espíritu aventurero, llegó a las colinas de Jalapa y
            no vio solamente belleza: vio una oportunidad.
          </p>
          <p>
            Su idea era simple y ambiciosa a la vez: levantar un refugio que
            mostrara al mundo el encanto del norte del país. Un lugar donde
            cualquiera, de aquí o de afuera, se sintiera en casa desde el primer
            día.
          </p>
          <p>
            {years} años después, esa idea sigue siendo la misma. Lo único que
            cambió fue el tamaño del jardín.
          </p>
        </div>

        <figure class="mt-10 flex gap-5">
          <span aria-hidden="true" class="mt-1 select-none text-6xl leading-none text-forest-700/35">
            &ldquo;
          </span>
          <div>
            <blockquote class="text-h3 leading-snug text-content">
              Crear un lugar donde el tiempo se detenga.
            </blockquote>
            <figcaption class="mt-4 text-2xs uppercase tracking-[0.16em] text-content-subtle">
              Wilhelmus Johannes Maria
            </figcaption>
          </div>
        </figure>
      </div>
    </div>
  </Section>

  <!-- Línea de tiempo -->
  <Section tone="sunken">
    <div class="max-w-2xl" data-reveal>
      <p class="kicker mb-5">Línea de tiempo</p>
      <h2 class="text-h2">Cómo llegamos hasta acá</h2>
      <p class="text-lead mt-4 text-content-muted">
        Cuatro momentos que explican lo que hoy encontrás al cruzar el portón.
      </p>
    </div>

    <ol class="mt-16 space-y-16 md:space-y-24">
      {timeline.map((entry, i) => (
        <li class="grid gap-8 md:grid-cols-12 md:gap-12">
          <div
            class:list={["md:col-span-6", i % 2 === 1 && "md:order-2"]}
            data-reveal={i % 2 === 0 ? "left" : "right"}
          >
            <div class="card-media aspect-4/3 rounded-media" data-reveal-media>
              <Media
                src={entry.image}
                alt={entry.alt}
                widths={[480, 720, 960]}
                sizes="(min-width: 768px) 48vw, 100vw"
                class={`size-full object-cover ${entry.year === "2003" ? "grayscale" : ""}`}
              />
            </div>
          </div>

          <div
            class="md:col-span-6 md:self-center"
            data-reveal={i % 2 === 0 ? "right" : "left"}
          >
            <p class="text-2xs font-semibold uppercase tracking-[0.2em] text-content-subtle">
              {entry.year}
            </p>
            <h3 class="text-h2 mt-3">{entry.title}</h3>
            <p class="text-lead mt-4 text-content-muted">{entry.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <!-- Valores -->
  <Section tone="surface">
    <div class="max-w-2xl" data-reveal>
      <p class="kicker mb-5">Lo que no cambia</p>
      <h2 class="text-h2">Nuestra promesa</h2>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-3" data-reveal-group>
      {values.map((value) => (
        <article class="card-interactive p-8">
          <h3 class="text-h3">{value.title}</h3>
          <p class="mt-3 text-content-muted">{value.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <RelatedLinks current="/historia" title="Lo que vas a encontrar" />

  <!-- Cierre único de la página -->
  <Section tone="inverse">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-end" data-reveal>
      <div class="max-w-xl">
        <h2 class="text-h2 text-white">Tu próxima escapada al campo</h2>
        <p class="text-lead mt-4 text-white/65">
          La mejor forma de entender {years} años de historia es pasar aquí un
          fin de semana.
        </p>
      </div>
      <Button
        href={whatsappLink(waMessages.room)}
        external
        variant="light"
        size="lg"
        icon="whatsapp"
        iconPosition="start"
      >
        Reservar por WhatsApp
      </Button>
    </div>
  </Section>
</Layout>
