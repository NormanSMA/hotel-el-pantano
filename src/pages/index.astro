---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Promise from "../components/sections/Promise.astro";
import Signature from "../components/sections/Signature.astro";
import RoomsPreview from "../components/sections/RoomsPreview.astro";
import HistoryTeaser from "../components/sections/HistoryTeaser.astro";
import EventsTeaser from "../components/sections/EventsTeaser.astro";
import LocationStrip from "../components/sections/LocationStrip.astro";
import { site } from "../data/site";
---

<Layout
  title={`${site.name} | Jalapa, Nueva Segovia`}
  description="Hotel campestre y restaurante en Jalapa, Nueva Segovia. Cabañas desde C$500, cocina nicaragüense y salón para hasta 400 personas. Reservá por WhatsApp."
>
  <Hero />
  <Promise />
  <Signature />
  <RoomsPreview />
  <EventsTeaser />
  <HistoryTeaser />
  <LocationStrip />
</Layout>
