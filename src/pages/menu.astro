---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import SplitText from "../components/ui/SplitText.astro";
import RelatedLinks from "../components/ui/RelatedLinks.astro";
import { menuSections, formatPrice } from "../data/menu";
import { site, whatsappLink, waMessages, hours } from "../data/site";
import { breadcrumbSchema } from "../lib/seo";

const crumbs = [{ label: "Inicio", href: "/" }, { label: "Restaurante" }];

const menuSchema = {
  "@type": "Menu",
  "@id": `${site.url}/menu#menu`,
  name: "Menú de Hotel & Restaurante El Pantano",
  inLanguage: "es-NI",
  hasMenuSection: menuSections.map((section) => ({
    "@type": "MenuSection",
    name: section.title,
    description: section.subtitle,
    hasMenuItem: section.categories.flatMap((cat) =>
      cat.items.map((item) => ({
        "@type": "MenuItem",
        name: `${cat.title}: ${item.name}`,
        ...(item.description ? { description: item.description } : {}),
        ...(item.price !== null
          ? { offers: { "@type": "Offer", price: item.price, priceCurrency: "NIO" } }
          : {}),
      }))
    ),
  })),
};
---

<Layout
  title="Menú del Restaurante en Jalapa"
  description="Carta del restaurante de El Pantano en Jalapa: alitas, tostones, hamburguesas, filetes, micheladas y batidos, con precios en córdobas. Abierto a diario."
  schema={[breadcrumbSchema(crumbs), menuSchema]}
>
  <PageHero
    eyebrow="Restaurante"
    title="La carta completa"
    lead="Cocina nicaragüense sin pretensiones, hecha al momento. Los precios están en córdobas e incluyen el acompañamiento indicado."
    image="/images/comida/papas-preparadas.webp"
    imageAlt="Papas preparadas servidas en el restaurante de El Pantano"
  />

  <!-- Navegación interna del menú -->
  <nav
    aria-label="Secciones del menú"
    class="sticky top-20 z-30 border-b border-subtle bg-surface md:top-24 [:has(#navbar.is-hidden)_&]:top-0 md:[:has(#navbar.is-hidden)_&]:top-0"
  >
    <div class="container-site">
      <ul class="flex gap-2 overflow-x-auto py-3.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {menuSections.map((section) => (
          <li>
            <a
              href={`#${section.id}`}
              class="menu-tab inline-block whitespace-nowrap rounded-full border border-subtle px-4 py-2 text-sm text-content-muted transition-colors hover:border-default hover:text-content"
              data-section={section.id}
            >
              {section.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="border-b border-subtle bg-surface-sunken">
    <div class="container-site flex flex-wrap items-center justify-center gap-x-8 gap-y-2 py-3.5 text-sm text-content-muted">
      <span class="inline-flex items-center gap-2">
        <Icon name="clock" class="size-4 text-content-subtle" />
        {hours.restaurant.value}
      </span>
      <span class="inline-flex items-center gap-2">
        <Icon name="star" class="size-3.5 text-gold-600" />
        Las recomendaciones de la casa van marcadas
      </span>
    </div>
  </div>

  {menuSections.map((section, index) => (
    <Section id={section.id} tone={index % 2 === 0 ? "surface" : "sunken"}>
      <div class="max-w-2xl" data-reveal>
        <SplitText as="h2" text={section.title} trigger="view" class="text-h2" />
        <p class="text-lead mt-4 text-content-muted">{section.subtitle}</p>
      </div>

      <div
        class:list={[
          "mt-20 grid gap-x-12 gap-y-16 lg:gap-x-16 lg:gap-y-20",
          section.categories.length >= 4 ? "md:grid-cols-2" : "md:grid-cols-2 lg:grid-cols-3",
        ]}
        data-reveal-group
      >
        {section.categories.map((category) => (
          <article class="card p-7 md:p-10">
            <header>
              <SplitText as="h3" text={category.title} trigger="view" class="text-h3" />
              {category.note && (
                <p class="mt-1.5 text-sm text-content-subtle">{category.note}</p>
              )}
            </header>

            <ul class="mt-6 space-y-1">
              {category.items.map((item) => (
                <li
                  class:list={[
                    "-mx-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-surface-sunken",
                    item.featured && "bg-surface-sunken",
                  ]}
                >
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="flex items-center gap-2 text-content">
                      {item.featured && (
                        <Icon
                          name="star"
                          class="size-3.5 shrink-0 text-gold-600"
                          label="Recomendación de la casa"
                        />
                      )}
                      {item.name}
                    </span>
                    <span
                      class:list={[
                        "shrink-0 tabular-nums",
                        item.price === null
                          ? "text-sm text-content-subtle"
                          : "font-semibold text-content",
                      ]}
                    >
                      {formatPrice(item.price)}
                    </span>
                  </div>
                  {item.description && (
                    <p class="mt-1 max-w-md text-sm leading-snug text-content-subtle">
                      {item.description}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </Section>
  ))}

  <RelatedLinks current="/menu" />

  <!-- Cierre único de la página -->
  <Section tone="inverse">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-end" data-reveal>
      <div class="max-w-xl">
        <SplitText as="h2" text="¿Reservamos tu mesa?" trigger="view" class="text-h2 text-white" />
        <p class="text-lead mt-4 text-white/65">
          Escribinos con la hora y cuántos son. Para llevar, hacé el pedido por
          el mismo número.
        </p>
      </div>
      <Button href={whatsappLink(waMessages.order)} external variant="light" size="lg" icon="whatsapp" iconPosition="start" magnetic>
        Escribir por WhatsApp
      </Button>
    </div>
  </Section>

  <script>
    // Resalta la pestaña de la sección visible mientras se hace scroll.
    const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>(".menu-tab"));
    const sections = tabs
      .map((tab) => document.getElementById(tab.dataset.section ?? ""))
      .filter((el): el is HTMLElement => el !== null);

    if (sections.length > 0 && "IntersectionObserver" in window) {
      const setActive = (id: string) => {
        tabs.forEach((tab) => {
          const active = tab.dataset.section === id;
          tab.classList.toggle("bg-action", active);
          tab.classList.toggle("text-action-content", active);
          tab.classList.toggle("border-transparent", active);
          tab.classList.toggle("border-subtle", !active);
          tab.classList.toggle("text-content-muted", !active);
          if (active) tab.setAttribute("aria-current", "true");
          else tab.removeAttribute("aria-current");
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) setActive(visible.target.id);
        },
        { rootMargin: "-30% 0px -55% 0px", threshold: [0, 0.25, 0.5] }
      );

      sections.forEach((section) => observer.observe(section));
    }
  </script>
</Layout>
